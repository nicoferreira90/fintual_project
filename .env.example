# Copy to .env and adjust. Compose reads .env automatically.
# docker-compose.yml's web service reads this as DEBUG: "${DEBUG:-true}", so
# `DEBUG=false docker compose up -d web` overrides it per-invocation without
# touching this file or docker-compose.yml -- used for benchmark runs
# (see docs/bench/before.md).
DEBUG=true
SECRET_KEY=dev-only-not-a-real-secret
ALLOWED_HOSTS=*

# Either set DATABASE_URL (what Fly injects)...
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend_devops_interview

# ...or the discrete variables. Compose sets POSTGRES_HOST=db.
POSTGRES_DB=backend_devops_interview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CONN_MAX_AGE=60

# Host-side port Compose publishes the db container on (container-internal
# port is always 5432). Override if 5432 is already taken by a local Postgres.
DB_PORT=5432

# Gunicorn (production image only)
WEB_CONCURRENCY=2
WEB_THREADS=4
